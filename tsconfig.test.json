// Type-checks tests and maintenance scripts with the same strictness as src. The build config keeps
// rootDir src, so non-published files use their own noEmit project instead of loosening the build.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    // The maintenance scripts are plain JavaScript. allowJs lets the tests import the shared export
    // list from one of them; checkJs stays off, so those files are resolved but not type-checked.
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"]
}
