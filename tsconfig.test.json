// Type-checks tests and maintenance scripts with the same strictness as src. The build config keeps
// rootDir src, so non-published files use their own noEmit project instead of loosening the build.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    // The .mjs maintenance scripts run on bare node, so they stay plain JavaScript with JSDoc types.
    // allowJs brings them into this program and checkJs holds them to the same strict checks as the
    // TypeScript scripts and tests.
    "allowJs": true,
    "checkJs": true,
    // Declaration isolation guards the published declarations, which only the build config emits. It
    // also cannot be combined with allowJs.
    "isolatedDeclarations": false
  },
  // src is not re-listed: the build config already checks it as roots, and every src file these
  // roots import is still fully checked as part of this program.
  "include": ["test", "scripts"]
}
