{
  "name": "signalk-chart-sources",
  "version": "0.7.2",
  "description": "Shared definitions of the chart and raster overlay sources for the Binnacle chartplotter and the Chart Locker tile cache.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "MIGRATING.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "lint": "npm run lint:code && npm run lint:docs && npm run spellcheck",
    "lint:code": "biome lint .",
    "lint:docs": "markdownlint-cli2 \"*.md\" \".github/**/*.md\"",
    "spellcheck": "cspell --no-progress --show-suggestions \"*.md\" \".github/**/*.{md,yml,yaml}\" \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*\"",
    "ci:biome": "biome ci .",
    "ci:workflows": "node scripts/check-workflows.mjs",
    "deadcode": "knip",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 test/*.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:upstreams": "node --import tsx scripts/check-upstreams.ts",
    "audit:full": "npm audit --json | node scripts/check-audit.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "verify:commit": "npm run ci:biome && npm run ci:workflows && npm run lint:docs && npm run spellcheck && npm run deadcode",
    "verify:fast": "npm run verify:commit && npm run typecheck",
    "verify": "npm run verify:fast && npm run test:coverage && npm run test:package && npm run audit:full && npm run audit:runtime"
  },
  "keywords": [
    "signalk",
    "chartplotter",
    "tiles",
    "xyz",
    "wms",
    "wmts",
    "arcgis",
    "vector-style",
    "web-mercator",
    "marine",
    "chart-sources"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "author": {
    "name": "Nearl Crews",
    "email": "NearlCrews@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/NearlCrews/signalk-chart-sources#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NearlCrews/signalk-chart-sources.git"
  },
  "bugs": {
    "url": "https://github.com/NearlCrews/signalk-chart-sources/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "cspell": "10.3.6",
    "fast-xml-parser": "5.11.2",
    "knip": "6.39.0",
    "markdownlint-cli2": "0.23.3",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.9.0"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
